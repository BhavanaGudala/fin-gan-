        <mxCell id="latent_label" value="&lt;font color=&quot;#9673a6&quot;&gt;&lt;i&gt;Latent: 128-dim&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="155" y="490" width="120" height="20" as="geometry"/>
        </mxCell>

        <!-- === DECODER SECTION === -->
