  <diagram id="ae-wgan-gp" name="AE-WGAN-GP Architecture (Phase 10)">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="&lt;b&gt;AE-WGAN-GP Architecture (Phase 10)&lt;/b&gt;&lt;br&gt;Unsupervised GAN-Based Network Intrusion Detection&lt;br&gt;&lt;i&gt;Bidirectional GRU + Attention Pooling + Mahalanobis Scoring&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="560" height="70" as="geometry"/>
        </mxCell>

        <!-- ==================== TRAINING DATA ==================== -->
