          </mxGeometry>
        </mxCell>

        <!-- DECODER ARROWS -->
        <mxCell id="a_dec_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="dec_gru" target="gen_norm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_norm_drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="gen_norm" target="gen_drop" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_drop_fc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" source="gen_drop" target="gen_fc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_fc_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" source="gen_fc" target="gen_out" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== DISCRIMINATOR CONTAINER ==================== -->
        <mxCell id="disc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="280" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="disc_label" value="&lt;b&gt;DISCRIMINATOR (Critic)&lt;/b&gt;&lt;br&gt;456,450 parameters" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#1A3A5C;" vertex="1" parent="1">
          <mxGeometry x="745" y="255" width="190" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="disc_input" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;x or x̂&lt;br&gt;(batch, 10, 77)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="310" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="disc_gru" value="&lt;b&gt;Bidirectional GRU&lt;/b&gt;&lt;br&gt;2-layer, bidir&lt;br&gt;77 → 128×2 = 256&lt;br&gt;dropout=0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="390" width="170" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="disc_norm" value="&lt;b&gt;LayerNorm&lt;/b&gt;&lt;br&gt;(256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="485" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="disc_drop" value="&lt;b&gt;Dropout&lt;/b&gt;&lt;br&gt;p=0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="555" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="attn_pool" value="&lt;b&gt;Attention Pooling&lt;/b&gt;&lt;br&gt;Linear(256→1) + Softmax&lt;br&gt;Weighted sum over timesteps&lt;br&gt;(batch,10,256) → (batch,256)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="625" width="210" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="disc_fc" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;256 → 1&lt;br&gt;&lt;i&gt;(no sigmoid)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="720" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="disc_score" value="&lt;b&gt;Wasserstein Score&lt;/b&gt;&lt;br&gt;(batch, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="800" width="150" height="45" as="geometry"/>
        </mxCell>

        <!-- DISCRIMINATOR ARROWS -->
        <mxCell id="a_di_gru" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_input" target="disc_gru" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dgru_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="disc_gru" target="disc_norm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dnorm_drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="disc_norm" target="disc_drop" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_ddrop_attn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" source="disc_drop" target="attn_pool" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_attn_dfc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" source="attn_pool" target="disc_fc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dfc_score" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_fc" target="disc_score" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DATA TO DISC (real) -->
        <mxCell id="a_data_disc" value="&lt;i&gt;real&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;" edge="1" source="data" target="disc_input" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- GEN OUT TO DISC (fake) -->
        <mxCell id="a_genout_disc" value="&lt;i&gt;fake&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d6b656;dashed=1;" edge="1" source="gen_out" target="disc_input" parent="1">
          <mxGeometry relative="1" as="geometry">
