        <mxCell id="gen_out" value="&lt;b&gt;x̂ (Reconstructed)&lt;/b&gt;&lt;br&gt;(batch, 10, 77)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
