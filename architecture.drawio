        </mxCell>
        <mxCell id="a_dec_ben" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" source="inf_decision" target="inf_benign" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dec_atk" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#B71C1C;" edge="1" source="inf_decision" target="inf_attack" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- x also feeds into MSE calc -->
        <mxCell id="a_x_mse" value="&lt;i&gt;x (original)&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#666666;dashed=1;" edge="1" source="test_input" target="inf_mse" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="165" y="1070"/>
              <mxPoint x="560" y="1070"/>
