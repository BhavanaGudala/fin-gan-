        <mxCell id="bottleneck" value="&lt;b&gt;Bottleneck&lt;/b&gt;&lt;br&gt;hidden[-1] → (batch, 128)&lt;br&gt;repeat → (batch, 10, 128)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
