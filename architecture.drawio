        <mxCell id="title" value="&lt;b&gt;AE-WGAN-GP Architecture&lt;/b&gt;&lt;br&gt;Unsupervised GAN-Based Intrusion Detection System&lt;br&gt;&lt;i&gt;Bidirectional GRU + Attention Pooling with WGAN-GP&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
