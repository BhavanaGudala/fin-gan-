        <!-- ==================== LOSS SECTION ==================== -->
        <mxCell id="loss_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="250" width="420" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="loss_title" value="&lt;b&gt;TRAINING LOSSES&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1195" y="255" width="150" height="30" as="geometry"/>
        </mxCell>

        <!-- Critic Loss -->
        <mxCell id="d_loss" value="&lt;b&gt;Critic Loss (D)&lt;/b&gt;&lt;hr&gt;D_loss = −(D(x) − D(x̂)) + λ·GP&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Maximize gap: real↑  fake↓&lt;br&gt;λ = 10 (gradient penalty)&lt;br&gt;Gradient clip: max_norm=1.0&lt;br&gt;Updated 5× per G update&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="310" width="220" height="140" as="geometry"/>
        </mxCell>

        <!-- GP Detail -->
        <mxCell id="gp_detail" value="&lt;b&gt;Gradient Penalty&lt;/b&gt;&lt;br&gt;GP = E[(‖∇D(x̃)‖₂ − 1)²]&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;x̃ = α·x + (1−α)·x̂&lt;br&gt;Enforces 1-Lipschitz constraint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="480" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Generator Loss -->
        <mxCell id="g_loss" value="&lt;b&gt;Generator Loss (G)&lt;/b&gt;&lt;hr&gt;G_loss = −D(x̂) + w·MSE(x, x̂)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;recon_weight (w) = 1.0&lt;br&gt;Fool critic + reconstruct input&lt;br&gt;Gradient clip: max_norm=1.0&lt;br&gt;Updated 1× per 5 D updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="580" width="220" height="140" as="geometry"/>
        </mxCell>

        <!-- Early Stopping -->
        <mxCell id="early_stop" value="&lt;b&gt;Early Stopping&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Metric: reconstruction loss&lt;br&gt;Patience: 15 epochs&lt;br&gt;Max epochs: 100&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="1340" y="370" width="120" height="120" as="geometry"/>
        </mxCell>

        <!-- Arrow from D score to D loss -->
        <mxCell id="a_score_dloss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_score" target="d_loss" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="822"/>
              <mxPoint x="1050" y="380"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== INFERENCE SECTION ==================== -->
        <mxCell id="inf_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="930" width="900" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inf_title" value="&lt;b&gt;INFERENCE (Anomaly Scoring)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="380" y="935" width="250" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="test_input" value="&lt;b&gt;Test Flow&lt;/b&gt;&lt;br&gt;x: (batch, 10, 77)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Benign or Attack&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="980" width="130" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="inf_gen" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br&gt;x̂ = G(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="985" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="inf_mse" value="&lt;b&gt;Reconstruction Error&lt;/b&gt;&lt;br&gt;MSE(x, x̂)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;mean over features &amp;amp; timesteps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="980" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="inf_decision" value="&lt;b&gt;score &gt; θ ?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;θ via Youden's J&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#999999;fontSize=10;size=0.18;" vertex="1" parent="1">
          <mxGeometry x="700" y="970" width="110" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="inf_benign" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;BENIGN&lt;/b&gt;&lt;br&gt;Low recon error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="960" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="inf_attack" value="&lt;font color=&quot;#B71C1C&quot;&gt;&lt;b&gt;ATTACK&lt;/b&gt;&lt;br&gt;High recon error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="1040" width="110" height="40" as="geometry"/>
        </mxCell>

        <!-- Inference arrows -->
        <mxCell id="a_ti_gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" source="test_input" target="inf_gen" parent="1">
          <mxGeometry relative="1" as="geometry"/>
