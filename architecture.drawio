        <mxCell id="a_gen_mse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#b85450;" edge="1" source="inf_gen" target="inf_mse" parent="1">
          <mxGeometry relative="1" as="geometry"/>
