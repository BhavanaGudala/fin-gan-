        <mxCell id="enc_label" value="&lt;b&gt;ENCODER&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontColor=#7F6000;" vertex="1" parent="1">
