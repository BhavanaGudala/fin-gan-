              <mxPoint x="215" y="540"/>
              <mxPoint x="350" y="540"/>
              <mxPoint x="350" y="392"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- DECODER ARROWS -->
        <mxCell id="a_dec_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="dec_gru" target="gen_norm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_norm_drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="gen_norm" target="gen_drop" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_drop_fc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" source="gen_drop" target="gen_fc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a_fc_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" source="gen_fc" target="gen_out" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== DISCRIMINATOR CONTAINER ==================== -->
        <mxCell id="disc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="280" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="disc_label" value="&lt;b&gt;DISCRIMINATOR (Critic)&lt;/b&gt;&lt;br&gt;448,770 parameters" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#1A3A5C;" vertex="1" parent="1">
          <mxGeometry x="745" y="275" width="190" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="disc_input" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;x or x̂&lt;br&gt;(batch, 20, 67)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="disc_gru" value="&lt;b&gt;Bidirectional GRU&lt;/b&gt;&lt;br&gt;2-layer, bidir&lt;br&gt;67 → 128×2 = 256&lt;br&gt;dropout=0.2&lt;br&gt;&lt;font color=&quot;#B71C1C&quot;&gt;&lt;i&gt;Spectral Norm (all 8 weights)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="410" width="190" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="disc_norm" value="&lt;b&gt;LayerNorm&lt;/b&gt;&lt;br&gt;(256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="520" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="disc_drop" value="&lt;b&gt;Dropout&lt;/b&gt;&lt;br&gt;p=0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="590" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="attn_pool" value="&lt;b&gt;Attention Pooling&lt;/b&gt;&lt;br&gt;Linear(256→1) + Softmax&lt;br&gt;Weighted sum over timesteps&lt;br&gt;(batch,20,256) → (batch,256)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="660" width="210" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="disc_fc" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;256 → 1&lt;br&gt;&lt;i&gt;Spectral Norm, no sigmoid&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="755" width="120" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="disc_score" value="&lt;b&gt;Wasserstein Score&lt;/b&gt;&lt;br&gt;D(x): (batch, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="840" width="150" height="45" as="geometry"/>
        </mxCell>

        <!-- DISCRIMINATOR ARROWS -->
        <mxCell id="a_di_gru" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_input" target="disc_gru" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dgru_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="disc_gru" target="disc_norm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dnorm_drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="disc_norm" target="disc_drop" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_ddrop_attn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" source="disc_drop" target="attn_pool" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_attn_dfc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" source="attn_pool" target="disc_fc" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_dfc_score" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_fc" target="disc_score" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DATA TO DISC (real) -->
        <mxCell id="a_data_disc" value="&lt;i&gt;real&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;" edge="1" source="data" target="disc_input" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- GEN OUT TO DISC (fake) -->
        <mxCell id="a_genout_disc" value="&lt;i&gt;fake&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#d6b656;dashed=1;" edge="1" source="gen_out" target="disc_input" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="667"/>
              <mxPoint x="660" y="310"/>
              <mxPoint x="835" y="310"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== LOSS SECTION ==================== -->
        <mxCell id="loss_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="270" width="440" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="loss_title" value="&lt;b&gt;TRAINING LOSSES &amp;amp; OPTIMIZERS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1160" y="275" width="230" height="30" as="geometry"/>
        </mxCell>

        <!-- Critic Loss -->
        <mxCell id="d_loss" value="&lt;b&gt;Critic Loss (D)&lt;/b&gt;&lt;hr&gt;D_loss = −(D(x) − D(x̂)) + λ·GP&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Maximize gap: real↑  fake↓&lt;br&gt;λ = 20 (gradient penalty)&lt;br&gt;Gradient clip: max_norm=1.0&lt;br&gt;Updated 3× per G update&lt;br&gt;lr_D = 5e-5 (Adam β₁=0.5, β₂=0.9)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="320" width="230" height="155" as="geometry"/>
        </mxCell>

        <!-- GP Detail -->
        <mxCell id="gp_detail" value="&lt;b&gt;Gradient Penalty&lt;/b&gt;&lt;br&gt;GP = E[(‖∇D(x̃)‖₂ − 1)²]&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;x̃ = α·x + (1−α)·x̂&lt;br&gt;Enforces 1-Lipschitz constraint&lt;br&gt;Also bounded by spectral norm&lt;br&gt; on all D weights (9 matrices)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="505" width="230" height="85" as="geometry"/>
        </mxCell>

        <!-- Generator Loss -->
        <mxCell id="g_loss" value="&lt;b&gt;Generator Loss (G)&lt;/b&gt;&lt;hr&gt;G_loss = −D(x̂) + 100·MSE(x, x̂)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;recon_weight = 100.0&lt;br&gt;Reconstruction-dominant (~94% of grad)&lt;br&gt;Gradient clip: max_norm=1.0&lt;br&gt;Updated 1× per 3 D updates&lt;br&gt;lr_G = 1e-4 (Adam β₁=0.5, β₂=0.9)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="620" width="230" height="160" as="geometry"/>
        </mxCell>

        <!-- Cosine LR -->
        <mxCell id="cosine_lr" value="&lt;b&gt;Cosine Annealing LR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;G: 1e-4 → 1e-5 over 300 epochs&lt;br&gt;D: 5e-5 → 5e-6 over 300 epochs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1340" y="320" width="140" height="65" as="geometry"/>
        </mxCell>

        <!-- Early Stopping -->
        <mxCell id="early_stop" value="&lt;b&gt;Early Stopping&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Metric: recon loss&lt;br&gt;Patience: 40 epochs&lt;br&gt;Max epochs: 300&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="1340" y="420" width="130" height="120" as="geometry"/>
        </mxCell>

        <!-- Arrow from D score to D loss -->
        <mxCell id="a_score_dloss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="disc_score" target="d_loss" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="862"/>
              <mxPoint x="1050" y="397"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== INFERENCE SECTION ==================== -->
        <mxCell id="inf_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="980" width="1420" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="inf_title" value="&lt;b&gt;INFERENCE — Multi-Signal Anomaly Scoring&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="500" y="985" width="350" height="30" as="geometry"/>
        </mxCell>

        <!-- Test Input -->
        <mxCell id="test_input" value="&lt;b&gt;Test Flow&lt;/b&gt;&lt;br&gt;x: (batch, 20, 67)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Benign or Attack&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1040" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- Signal 1: Recon -->
        <mxCell id="inf_gen" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br&gt;x̂ = G(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1030" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="inf_recon" value="&lt;b&gt;recon_z&lt;/b&gt;&lt;br&gt;MSE(x, x̂) → z-score&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;AUC: 0.9399&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="1025" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Signal 2: Latent Mahalanobis -->
        <mxCell id="inf_encode" value="&lt;b&gt;Encoder&lt;/b&gt;&lt;br&gt;z = G.encode(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1090" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="inf_latent" value="&lt;b&gt;latent_z ★ DOMINANT&lt;/b&gt;&lt;br&gt;Mahalanobis(z, μ_benign, Σ_benign)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;AUC: 0.9998 | LR coeff: 37.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="1085" width="210" height="50" as="geometry"/>
        </mxCell>

        <!-- Signal 3: D(x) -->
        <mxCell id="inf_disc" value="&lt;b&gt;Discriminator&lt;/b&gt;&lt;br&gt;D(x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecfc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1150" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="inf_dz" value="&lt;b&gt;d_z&lt;/b&gt;&lt;br&gt;−(D(x)−μ_D)/σ_D&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;AUC: 0.17 (weak)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="1145" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Signal 4: PF Mahalanobis -->
        <mxCell id="inf_pfmahal" value="&lt;b&gt;pf_mahal_z&lt;/b&gt;&lt;br&gt;Per-feature recon Mahalanobis&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;AUC: 0.9990&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="1205" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Learned Fusion -->
